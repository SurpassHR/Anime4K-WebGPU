{
  "name": "anime4k-webgpu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebGPU real-time Anime4K video upscaling/restoration browser extension",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8765 --strictPort",
    "serve": "npm run dev",
    "serve:demo": "vite --host 127.0.0.1 --port 8765 --strictPort --open /demo/",
    "dev:test": "vite --host 127.0.0.1 --port 8766 --strictPort",
    "build": "npm run typecheck && npm run build:site && npm run build:extension",
    "build:site": "vite build && node scripts/copy-docs.mjs",
    "build:extension": "vite build --config vite.extension.config.ts && vite build --config vite.popup.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 8765 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "npm run typecheck && npm run test:e2e",
    "test:e2e": "npm run build:extension && playwright test",
    "extract:weights": "python3 tools/extract_anime4k_weights.py --glsl research/anime4k-shaders --out research/weights.json",
    "validate:wgsl": "bash tools/validate-wgsl.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@xmsthc/studio-ui": "git+https://github.com/SurpassHR/studio-ui.git#v0.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
